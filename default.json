{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		"customManagers:githubActionsVersions",
		"customManagers:makefileVersions",
		"schedule:weekly"
	],
	"timezone": "America/Chicago",
	"nix": {
		"enabled": true,
		"lockFileMaintenance": {
			"enabled": true
		}
	},
	"packageRules": [
		{
			"groupName": "bun",
			"matchPackageNames": ["/oven-sh/bun/", "/oven/bun/"]
		},
		{
			"groupName": "pulumi",
			"matchDepNames": ["pulumi/pulumi$", "@pulumi/pulumi"]
		}
	],
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/\\.bun-version/", "/\\.versions\\/bun/"],
			"matchStrings": ["(?<currentValue>\\S+)"],
			"depNameTemplate": "oven-sh/bun",
			"datasourceTemplate": "github-releases",
			"extractVersionTemplate": "^bun-v(?<version>.*)"
		},
		{
			"customType": "regex",
			"managerFilePatterns": [
				"/\\.pulumi\\.version/",
				"/\\.versions\\/pulumi/"
			],
			"matchStrings": ["(?<currentValue>\\S+)"],
			"depNameTemplate": "pulumi/pulumi",
			"datasourceTemplate": "github-tags",
			"extractVersionTemplate": "^v(?<version>.*)"
		},
		{
			"customType": "regex",
			"managerFilePatterns": [
				"/\\.versions\\/kubernetes/",
				"/\\.versions\\/kubectl/"
			],
			"matchStrings": ["(?<currentValue>\\S+)"],
			"depNameTemplate": "kubernetes/kubernetes",
			"datasourceTemplate": "github-tags",
			"extractVersionTemplate": "^v(?<version>.*)"
		},
		{
			"customType": "regex",
			"managerFilePatterns": ["/\\.versions\\/buf/"],
			"matchStrings": ["(?<currentValue>\\S+)"],
			"depNameTemplate": "bufbuild/buf",
			"datasourceTemplate": "github-tags",
			"extractVersionTemplate": "^v(?<version>.*)"
		},
		{
			"customType": "regex",
			"managerFilePatterns": ["/\\.versions\\/dprint/"],
			"matchStrings": ["(?<currentValue>\\S+)"],
			"depNameTemplate": "dprint/dprint",
			"datasourceTemplate": "github-tags"
		},
		{
			"customType": "regex",
			"managerFilePatterns": ["/\\.versions\\/devctl/"],
			"matchStrings": ["(?<currentValue>\\S+)"],
			"depNameTemplate": "unmango/devctl",
			"datasourceTemplate": "github-releases",
			"extractVersionTemplate": "^v(?<version>.*)"
		},
		{
			"customType": "regex",
			"description": "dprint versions passed to dprint/check in workflows",
			"managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
			"matchStrings": [
				"(?:dprint-version|DPRINT_VERSION):\\s*[\"']?(?<currentValue>\\d[^\\s\"']*)"
			],
			"depNameTemplate": "dprint/dprint",
			"datasourceTemplate": "github-tags"
		}
	]
}
