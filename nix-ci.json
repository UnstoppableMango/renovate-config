{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"description": "Weekly grouped updates that automerge on green CI, for Nix repos. Extend after the default preset.",
	"timezone": "America/Chicago",
	"schedule": ["* 0-5 * * 1"],
	"minimumReleaseAge": "3 days",
	"rebaseWhen": "conflicted",
	"automerge": true,
	"automergeType": "pr",
	"platformAutomerge": true,
	"gitIgnoredAuthors": [
		"359966661+unmango-renovate-fixup[bot]@users.noreply.github.com"
	],
	"stopUpdatingLabel": "renovate:needs-human",
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["* 0-5 * * 1"]
	},
	"vulnerabilityAlerts": {
		"schedule": ["at any time"],
		"minimumReleaseAge": null
	},
	"packageRules": [
		{
			"description": "deploys.json reuses this group name and slug",
			"matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
			"groupName": "all non-major dependencies",
			"groupSlug": "all-non-major"
		},
		{
			"matchUpdateTypes": ["lockFileMaintenance"],
			"groupName": "lock file maintenance",
			"groupSlug": "lock-file-maintenance"
		},
		{
			"matchUpdateTypes": ["lockFileMaintenance"],
			"matchManagers": ["nix"],
			"groupName": "flake.lock maintenance",
			"groupSlug": "flake-lock-maintenance"
		},
		{
			"description": "Majors need a human",
			"matchUpdateTypes": ["major"],
			"automerge": false
		}
	]
}
